# ============================================================
# ElderLife AI — .gitignore
# Purpose: keep secrets, large data, build junk, and OS noise
# out of the Git repository.
#
# Rule of thumb: if a file is regenerated by a script, it does
# not belong in Git. If it is hand-written, it does.
# ============================================================

# ---- Secrets & local environment ----
# .env holds real values on your machine; .env.example (placeholders) is committed.
.env
.env.*
!.env.example
# Vite's local override files (frontend/.env.local and friends).
frontend/.env.local
frontend/.env.*.local

# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
coverage.xml
htmlcov/

# ---- Node / frontend ----
node_modules/
dist/
.vite/
coverage/
npm-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript incremental build caches (`tsc -b` writes one per project).
*.tsbuildinfo

# ---- Datasets (large, downloaded manually — see docs/datasets/) ----
# The folders are kept in Git via .gitkeep; the data inside them is not.
data/raw/**
!data/raw/.gitkeep
data/processed/**
!data/processed/.gitkeep
# `data/sample/` is deliberately NOT ignored: it holds small, hand-made
# examples that the tests use, and they belong in the repository.

# ---- Trained model artifacts (regenerate locally; never commit) ----
*.pkl
*.joblib
*.h5
*.hdf5
*.pt
*.pth
*.onnx
*.cbm
ai/models/
ai/**/models/

# ---- Generated analytics exports ----
analytics/exports/**
!analytics/exports/.gitkeep

# ---- Databases, logs, temporary files ----
*.sqlite
*.sqlite3
*.db
*.db-journal
*.db-wal
*.db-shm
*.log
*.tmp
*.orig
*.rej
~$*

# ---- OS junk ----
Thumbs.db
Desktop.ini
.DS_Store

# ---- IDE (uncomment .vscode line if you don't want to share editor settings) ----
.idea/
# .vscode/

# ---- Editor / OS swap files ----
*.swp
*.swo
.*.sw?
