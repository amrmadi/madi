# ============================================================
# ElderLife AI — environment template (PLACEHOLDERS ONLY)
#
# How to use:
#   1. Copy this file and name the copy ".env"
#   2. Edit the values in ".env" for your machine
#
# Rules:
#   * Never put real passwords, API keys, or personal data here.
#   * ".env" is git-ignored; this example file is safe to commit.
#   * Every value below is a LOCAL PLACEHOLDER. Generate your own
#     SECRET_KEY for anything beyond a throwaway demo (see below).
# ============================================================

# ---- PostgreSQL (used by docker-compose.yml and the backend) ----
POSTGRES_USER=elderlife_dev
POSTGRES_PASSWORD=change_me_local_only
POSTGRES_DB=elderlife
DB_HOST=localhost
DB_PORT=5432

# SQLAlchemy connection string, built from the values above.
# Driver is "psycopg" (installed with the backend dependencies later).
DATABASE_URL=postgresql+psycopg://elderlife_dev:change_me_local_only@localhost:5432/elderlife

# ---- Backend (FastAPI) ----
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
# Browser origin allowed to call the API during development (Vite dev server).
ALLOWED_ORIGINS=http://localhost:5173

# ---- Authentication ----
# Signs login tokens. The placeholder below is deliberately obvious and is only
# acceptable for a local demo: the backend REFUSES to start with ENVIRONMENT=
# production while it is still set to this value (see settings.validate_secret_key).
#
# Generate a real one before deploying anywhere:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=dev-only-insecure-secret-change-me

# ---- Frontend (Vite) ----
# Vite only exposes variables whose name starts with VITE_.
# Do NOT add /api/v1 here: the frontend client appends it itself.
# NOTE: this is read at BUILD time, not runtime, because it is compiled into the
# JavaScript bundle. Under Docker Compose it is passed as a build argument
# (see the `frontend` service in docker-compose.yml).
VITE_API_BASE_URL=http://localhost:8000

# ---- AI modules ----
# Where trained model files will be stored (this folder is git-ignored).
MODEL_DIR=./ai/models
# "development" or "production" — affects logging verbosity later.
ENVIRONMENT=development
