# Copy this file to `.env.local` and adjust if your backend runs elsewhere.
#
# The frontend already defaults to http://localhost:8000, so this file is only
# needed when the API lives on a different host or port.
#
# Do NOT put secrets here: everything prefixed with VITE_ is compiled into the
# JavaScript bundle and is visible to anyone who loads the page.

VITE_API_BASE_URL=http://localhost:8000

# Optional. Only needed if you use the `/api-proxy` path instead of talking to
# the API directly. Overrides the Vite dev-server proxy target.
# VITE_PROXY_TARGET=http://localhost:8000
